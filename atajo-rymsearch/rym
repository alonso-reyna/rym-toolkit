#!/bin/zsh
# Opens on RYM the album currently playing in Spotify (desktop app, macOS).
# Usage: rym                -> opens the release page directly (first result)
#        rym search         -> opens RYM's own search

info=$(osascript <<'EOF'
if application "Spotify" is not running then return ""
tell application "Spotify"
	if player state is stopped then return ""
	return (artist of current track) & "\t" & (album of current track)
end tell
EOF
)

if [[ -z "$info" ]]; then
  osascript -e 'display notification "Spotify is not playing anything" with title "RYM"'
  exit 1
fi

artist=${info%%$'\t'*}
album=${info#*$'\t'}
# Strips suffixes like "(Deluxe Edition)" or "- Remastered 2011" that pollute the search
album_clean=$(print -r -- "$album" | sed -E 's/ *[\(\[][^)\]]*(deluxe|remaster|edition|version|expanded|anniversary|bonus)[^)\]]*[\)\]]//I; s/ +- +.*(remaster|deluxe|edition|version).*$//I')

enc() { python3 -c 'import sys,urllib.parse;print(urllib.parse.quote_plus(sys.argv[1]))' "$1"; }

if [[ "$1" == "search" ]]; then
  url="https://rateyourmusic.com/search?searchtype=l&searchterm=$(enc "$artist $album_clean")"
else
  # "\" = DuckDuckGo's "I'm feeling ducky": redirects to the first result
  url="https://duckduckgo.com/?q=$(enc "\\site:rateyourmusic.com/release $artist $album_clean")"
fi

# "RYM Abrir.app" does the opening so permissions do not depend on whichever app is in front
mkdir -p ~/Library/Caches/rym && chmod 700 ~/Library/Caches/rym
print -r -- "$url" > ~/Library/Caches/rym/url
open -a ~/Applications/"RYM Abrir.app"
