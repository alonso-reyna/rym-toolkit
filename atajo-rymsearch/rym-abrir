#!/bin/zsh
# Opens in Chrome the URL saved by rym (~/Library/Caches/rym/url). Run by "RYM Abrir.app",
# the app that holds the Accessibility/Automation permissions (whatever app you trigger the shortcut from).
cache=~/Library/Caches/rym
url=$(<$cache/url)
log() { print -r -- "$(date +%T) $*" >> $cache/log; }
# Only URLs that rym builds (keeps anything odd from reaching Chrome as a command-line option)
case $url in
  https://duckduckgo.com/\?*|https://rateyourmusic.com/*) ;;
  *) log "url rejected: $url"; exit 1 ;;
esac

# 1. If a Chrome window already has RYM, open the album as a tab there and switch to that desktop
reuso=$(osascript - "$url" 2>&1 <<'EOF'
on run argv
	if application id "com.google.Chrome" is not running then return "no"
	tell application id "com.google.Chrome"
		repeat with w in windows
			repeat with t in tabs of w
				if URL of t contains "rateyourmusic.com" then
					tell w to make new tab with properties {URL:(item 1 of argv)}
					set index of w to 1
					activate
					return "ok"
				end if
			end repeat
		end repeat
	end tell
	return "no"
end run
EOF
)
log "reuse: $reuso"
[[ "$reuso" == "ok" ]] && exit 0

# 2. Otherwise: move to the nearest empty desktop (on the screen you are on)
res=$(osascript -l JavaScript ~/.local/bin/rym-espacio-vacio.js 2>&1)
log "space: $res"
area=${res#* }; [[ "$area" == "$res" ]] && area=""   # "x1 y1 x2 y2", or empty on error

# 3. New Chrome window. Save the ids of existing windows to recognize the new one.
antes=$(osascript -l JavaScript -e '
  const c = Application("com.google.Chrome");
  c.running() ? "," + c.windows.id().join(",") + "," : ","' 2>/dev/null)
open -gnb com.google.Chrome --args --profile-directory="Default" --new-window "$url"

# 4. Wait for it to appear (up to 10 s; a cold start is slow), fit it into this screen's area
#    and bring it to the front. Activating Chrome before the window exists made macOS jump
#    to another desktop with Chrome windows and left you on the empty one.
fin=$(osascript -l JavaScript - "$antes" "$area" 2>&1 <<'EOF'
function run([antes, area]) {
  const c = Application('com.google.Chrome');
  let w = null;
  for (let t = 0; t < 100 && !w; t++) {
    delay(0.1);
    try { w = c.windows().find(v => !antes.includes(',' + v.id() + ',')) || null; } catch (e) {}
  }
  if (!w) { c.activate(); return 'no-window'; }
  const a = (area || '').split(' ').map(Number);
  if (a.length === 4 && a.every(Number.isFinite)) {
    const [x1, y1, x2, y2] = a, b = w.bounds();
    const ww = Math.min(b.width, x2 - x1), hh = Math.min(b.height, y2 - y1);
    // if it already fits inside the area, leave it; otherwise (e.g. Chrome opened it on the other screen) center it
    const dentro = b.x >= x1 && b.y >= y1 && b.x + b.width <= x2 && b.y + b.height <= y2;
    if (!dentro) w.bounds = { x: Math.round(x1 + (x2 - x1 - ww) / 2), y: Math.round(y1 + (y2 - y1 - hh) / 2), width: ww, height: hh };
  }
  w.index = 1;
  c.activate();
  return 'ok';
}
EOF
)
log "window: $fin"
