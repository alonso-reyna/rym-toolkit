#!/bin/zsh
# Opens in Chrome the URL saved by rym (~/Library/Caches/rym/url). Run by "RYM Abrir.app",
# the app that holds the Automation permission (whatever app you trigger the shortcut from).
cache=~/Library/Caches/rym
url=$(<$cache/url)
log() { print -r -- "$(date +%T) $*" >> $cache/log; }
# Only URLs that rym builds (keeps anything odd from reaching Chrome as a command-line option)
case $url in
  https://duckduckgo.com/\?*|https://rateyourmusic.com/*) ;;
  *) log "url rejected: $url"; exit 1 ;;
esac

# 1. If a Chrome window already has RYM, open the album as a tab there and bring it to the front
reuso=$(osascript - "$url" 2>&1 <<'EOF'
on run argv
	if application id "com.google.Chrome" is not running then return "no"
	tell application id "com.google.Chrome"
		repeat with w in windows
			repeat with t in tabs of w
				if URL of t contains "rateyourmusic.com" then
					tell w to make new tab with properties {URL:(item 1 of argv)}
					set index of w to 1
					activate
					return "ok"
				end if
			end repeat
		end repeat
	end tell
	return "no"
end run
EOF
)
log "reuse: $reuso"
[[ "$reuso" == "ok" ]] && exit 0

# 2. Otherwise: a new Chrome window (Default profile) on the desktop you are on.
#    Save the ids of existing windows to recognize the new one.
antes=$(osascript -l JavaScript -e '
  const c = Application("com.google.Chrome");
  c.running() ? "," + c.windows.id().join(",") + "," : ","' 2>/dev/null)
open -gnb com.google.Chrome --args --profile-directory="Default" --new-window "$url"

# 3. Wait for it to appear (up to 10 s; a cold start is slow) and bring it to the front.
#    Activating Chrome before the window exists makes macOS jump to another desktop with Chrome windows.
fin=$(osascript -l JavaScript - "$antes" 2>&1 <<'EOF'
function run([antes]) {
  const c = Application('com.google.Chrome');
  let w = null;
  for (let t = 0; t < 100 && !w; t++) {
    delay(0.1);
    try { w = c.windows().find(v => !antes.includes(',' + v.id() + ',')) || null; } catch (e) {}
  }
  if (w) w.index = 1;
  c.activate();
  return w ? 'ok' : 'no-window';
}
EOF
)
log "window: $fin"
